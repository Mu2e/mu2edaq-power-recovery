# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
.venv/
.pytest_cache/
.coverage
htmlcov/

# CMake / C++
build/
*.so
*.dylib
*.dll
*.o
*.a

# Runtime artefacts
data/*.db
data/*.db-journal
logs/*.log
# The run lock (#12) is kept on purpose after every run, and the old start
# script left pid files behind; either, untracked, made phase 0 see a dirty
# tree and stop self-updating for good (PR #32 review).
logs/*.lock
logs/*.pid
core/*
!core/.gitkeep
config/.env

# Generated report output. The pages are produced by every run; committing them
# would mean a diff on each one, and the report is an artefact of a recovery,
# not source. The directory itself is kept so a fresh clone can write into it.
html/*
!html/.gitkeep

# Editors / OS
.DS_Store
*.swp
