# Copy to config/.env and edit.  Values here override config/*.yaml but are
# themselves overridden by the environment and by command-line flags.
#
# config/.env is in .gitignore -- never commit a filled-in copy.

# --- run behaviour ---------------------------------------------------------
#MU2E_POWER_RECOVERY_RUN_LABEL="Sept 2026 planned outage"
#MU2E_POWER_RECOVERY_RUN_DRY_RUN=true

# --- identities ------------------------------------------------------------
#MU2E_POWER_RECOVERY_KERBEROS_PRINCIPAL=anorman@FNAL.GOV
#MU2E_POWER_RECOVERY_KERBEROS_ROOT_PRINCIPAL=anorman/root@FNAL.GOV

# --- vault -----------------------------------------------------------------
#VAULT_ADDR=https://ssivault.fnal.gov:8200
# A token may also be supplied here, but prefer `vault login`, which caches
# to ~/.vault-token and keeps the token out of the process environment.
#VAULT_TOKEN=

# --- report publication ----------------------------------------------------
#MU2E_POWER_RECOVERY_REPORT_OUTPUT_DIR=html
#MU2E_POWER_RECOVERY_REPORT_PUBLISH_ENABLED=true
#MU2E_POWER_RECOVERY_REPORT_PUBLISH_TARGET=mu2edaq@mu2egateway01.fnal.gov:/web/recovery/

# --- database --------------------------------------------------------------
#MU2E_POWER_RECOVERY_DATABASE_URL=postgresql+psycopg2://mu2e@dbhost/power_recovery
